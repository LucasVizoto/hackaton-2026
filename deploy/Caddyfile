{
    admin unix//run/cocapec-caddy/admin.sock
    servers {
        trusted_proxies static {$CLOUDFLARE_CIDRS}
        trusted_proxies_strict
        client_ip_headers CF-Connecting-IP
    }
}

cocapec.lucasvizoto.com {
    encode gzip zstd
    log {
        format filter {
            wrap json
            fields {
                request>uri query {
                    delete token
                }
            }
        }
        output file /var/log/caddy/cocapec-access.log {
            roll_size 20MiB
            roll_keep 5
        }
    }
    request_body {
        max_size 12MiB
    }
    @private path /.env* /.git/* /.private/* /media/* /sources/* /backups/*
    handle @private {
        respond 404
    }
    @backend path /api/* /ws/*
    handle @backend {
        header Cache-Control "private, no-store"
        reverse_proxy 127.0.0.1:8000 {
            header_up X-Forwarded-For {client_ip}
            header_up X-Forwarded-Proto https
            header_up -CF-Connecting-IP
        }
    }
    handle {
        root * /srv/cocapec/current/frontend/dist/browser
        @immutable path_regexp immutable ^/[^/]+-[A-Z0-9]{8,}\.(js|css)$
        header @immutable Cache-Control "public, max-age=31536000, immutable"
        @runtime path /runtime-config.json
        header @runtime Cache-Control "no-store"
        route {
            try_files {path} /index.html
            @html path /index.html
            header @html Cache-Control "no-cache"
            file_server
        }
    }
}
