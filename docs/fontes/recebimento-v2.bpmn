<?xml version='1.0' encoding='utf-8'?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="DefinitionsV2" targetNamespace="urn:recebimento:v2">
  <process id="SupplierProcess" isExecutable="false">
    <task id="request" name="Solicitar carga com notas" />
  </process>
  <process id="ReceivingProcess" isExecutable="false">
    <laneSet id="Roles">
      <lane id="Lane0" name="Portaria">
        <flowNodeRef>gatein</flowNodeRef>
        <flowNodeRef>gateout</flowNodeRef>
        <flowNodeRef>end</flowNodeRef>
      </lane>
      <lane id="Lane1" name="Compras">
        <flowNodeRef>review</flowNodeRef>
        <flowNodeRef>decision</flowNodeRef>
      </lane>
      <lane id="Lane2" name="Armazém">
        <flowNodeRef>start</flowNodeRef>
        <flowNodeRef>fork</flowNodeRef>
        <flowNodeRef>destinations</flowNodeRef>
        <flowNodeRef>join</flowNodeRef>
        <flowNodeRef>visits</flowNodeRef>
        <flowNodeRef>receipt</flowNodeRef>
        <flowNodeRef>resolved</flowNodeRef>
        <flowNodeRef>lastout</flowNodeRef>
      </lane>
    </laneSet>
    <startEvent id="start" name="start">
      <messageEventDefinition />
    </startEvent>
    <parallelGateway id="fork" name="fork" />
    <task id="gatein" name="Chegada à Portaria" />
    <task id="review" name="Conferir notas / pedido" />
    <task id="destinations" name="Confirmar destinos" />
    <parallelGateway id="join" name="join" />
    <task id="visits" name="Executar visitas" />
    <task id="receipt" name="Conferir todos os itens" />
    <exclusiveGateway id="resolved" name="resolved" />
    <task id="decision" name="Decidir divergência" />
    <task id="lastout" name="Última saída do local" />
    <task id="gateout" name="Saída da Portaria" />
    <endEvent id="end" name="end" />
    <sequenceFlow id="e1" sourceRef="start" targetRef="fork" name="" />
    <sequenceFlow id="e2" sourceRef="fork" targetRef="gatein" name="" />
    <sequenceFlow id="e3" sourceRef="fork" targetRef="review" name="" />
    <sequenceFlow id="e4" sourceRef="review" targetRef="destinations" name="aprovado" />
    <sequenceFlow id="e5" sourceRef="gatein" targetRef="join" name="chegada registrada" />
    <sequenceFlow id="e6" sourceRef="destinations" targetRef="join" name="" />
    <sequenceFlow id="e7" sourceRef="join" targetRef="visits" name="" />
    <sequenceFlow id="e8" sourceRef="visits" targetRef="receipt" name="" />
    <sequenceFlow id="e9" sourceRef="receipt" targetRef="resolved" name="resolvido?" />
    <sequenceFlow id="e10" sourceRef="resolved" targetRef="decision" name="não" />
    <sequenceFlow id="e11" sourceRef="decision" targetRef="resolved" name="decisão" />
    <sequenceFlow id="e12" sourceRef="resolved" targetRef="lastout" name="sim" />
    <sequenceFlow id="e13" sourceRef="lastout" targetRef="gateout" name="" />
    <sequenceFlow id="e14" sourceRef="gateout" targetRef="end" name="" />
  </process>
  <collaboration id="ReceivingCollaboration">
    <participant id="SupplierParticipant" name="Fornecedor" processRef="SupplierProcess" />
    <participant id="ReceivingParticipant" name="Recebimento na unidade" processRef="ReceivingProcess" />
    <messageFlow id="RequestMessage" sourceRef="request" targetRef="start" name="Solicitação" />
  </collaboration>
  <bpmndi:BPMNDiagram id="DiagramV2">
    <bpmndi:BPMNPlane id="PlaneV2" bpmnElement="ReceivingCollaboration">
      <bpmndi:BPMNShape id="Shape_SupplierParticipant" bpmnElement="SupplierParticipant" isHorizontal="true">
        <dc:Bounds x="40" y="125" width="2300" height="145" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_ReceivingParticipant" bpmnElement="ReceivingParticipant" isHorizontal="true">
        <dc:Bounds x="35" y="285" width="2310" height="635" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane0" bpmnElement="Lane0" isHorizontal="true">
        <dc:Bounds x="40" y="290" width="2300" height="150" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane1" bpmnElement="Lane1" isHorizontal="true">
