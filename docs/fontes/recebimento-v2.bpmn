      <bpmndi:BPMNShape id="Shape_resolved" bpmnElement="resolved" isHorizontal="true">
        <dc:Bounds x="1770" y="705" width="75" height="75" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_decision" bpmnElement="decision" isHorizontal="true">
        <dc:Bounds x="1680" y="505" width="260" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_lastout" bpmnElement="lastout" isHorizontal="true">
