      <bpmndi:BPMNShape id="Shape_gateout" bpmnElement="gateout" isHorizontal="true">
        <dc:Bounds x="1930" y="325" width="250" height="85" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_end" bpmnElement="end" isHorizontal="true">
        <dc:Bounds x="2270" y="345" width="45" height="45" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Edge_RequestMessage" bpmnElement="RequestMessage">
