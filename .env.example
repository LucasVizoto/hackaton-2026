# Copy locally and replace every secret before running.
DJANGO_SECRET_KEY=
DEBUG=1
ALLOWED_HOSTS=127.0.0.1,localhost,10.0.2.2
DB_NAME=cocapec
DB_USER=cocapec
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=55433
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost,http://localhost:8100
PRIVATE_DATA_DIR=
MEDIA_ROOT=.private/media
DEMO_PASSWORD=

# Optional integrations: enable only after acceptance and account configuration.
OPTIONAL_INTEGRATIONS_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_VISION_MODEL=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
DIGEST_EMAIL_RECIPIENTS=
# JSON mapping to explicit recipient lists, e.g. {"warehouse":["armazem@example.com"]}
NOTIFICATION_EMAIL_RECIPIENTS={}
GOOGLE_CALENDAR_ID=
GOOGLE_CALENDAR_ACCESS_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=pt_BR
WHATSAPP_RECIPIENTS=
WEATHER_LATITUDE=
WEATHER_LONGITUDE=
